# Copy names only. Real values go in Vercel > Project > Settings > Environment Variables (added by Sidney).
# Never commit real values.

# GoHighLevel Private Integration token (investor sub-account). Server-side only.
GHL_API_TOKEN=
# Optional override; defaults to the investor sub-account in config/investor.ts
GHL_LOCATION_ID=
# Events allowed to write to GHL, comma separated. Empty = everything dry-run. Set ONLY with Sidney's explicit OK.
# apply-start (2), apply-complete (3), book (4), nda-sign (5), nda-skip (6), track (7)
GHL_LIVE_EVENTS=
# "true" adds the tag "test" to every contact a live event touches
GHL_TEST_MODE=true
# The investor call calendar (48 hour minimum notice, 6 day range, 60 minutes)
GHL_CALENDAR_ID=
# 32+ random characters. Required once any event is live. Signs the funnel cookie and the confirmation links.
FUNNEL_SESSION_SECRET=
# Public URL of the funnel, used in the calendar invite and confirmation links, e.g. https://fintechtransformation.info
NEXT_PUBLIC_SITE_URL=
