# Copy names only. Real values go in Vercel > Project > Settings > Environment Variables (added by Sidney).
# Never commit real values.

# GoHighLevel Private Integration token (investor sub-account). Server-side only.
GHL_PRIVATE_TOKEN=
# Set to "true" ONLY with Sidney's explicit OK. Anything else = dry-run (nothing sent to GHL).
GHL_LIVE=false
# Optional override; defaults to the investor sub-account in config/investor.ts
GHL_LOCATION_ID=
# The GHL calendar for Michael's first calls (create it with 48 hour minimum notice and a 7 day range)
GHL_CALENDAR_ID=
# 32+ random characters. Required when GHL_LIVE=true. Signs the funnel cookie.
FUNNEL_SESSION_SECRET=
# Public URL of the funnel, used in the calendar invite, e.g. https://fintechtransformation.info
NEXT_PUBLIC_SITE_URL=
